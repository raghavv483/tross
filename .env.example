# Copy to .env for local development. Never commit .env.
# Every variable below is optional unless stated; defaults are shown.
# Validated once at boot — invalid configuration throws before the server binds.

# --- server ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# trace | debug | info | warn | error | fatal | silent
# NOTE: `silent` means zero output — the server looks dead but is running.
LOG_LEVEL=info

# --- data source ---
# fixture | linkedin-oidc
PROFILE_SOURCE=fixture

# --- rate limiting (per IP; /health is exempt) ---
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# --- cache ---
# 0 disables caching
CACHE_TTL_SECONDS=900

# --- Apify provider (PROFILE_SOURCE=apify) ---
# Credentials for the Apify Actor that returns LinkedIn profile data.
# BOTH are required when PROFILE_SOURCE=apify; boot fails fast if either is
# missing. Leave them empty for the default fixture source, which needs no
# credentials and makes no network calls.
#
# APIFY_API_TOKEN is a SECRET. Never commit it. It is redacted in logs and is
# never included in any response body or error message. It is the ONLY Apify
# variable with no default, so boot fails fast when PROFILE_SOURCE=apify and it
# is missing.
# Find it at https://console.apify.com/settings/integrations
APIFY_API_TOKEN=
# The Actor to run, in "username/actor-name" form. Case-sensitive; converted to
# the tilde form for the API path. Defaults to the Actor this build's mapper is
# written against - change it only alongside a mapper that matches its output.
APIFY_ACTOR_ID=harvestapi/linkedin-profile-scraper
# The Actor's own input mode: selects which field set and price tier a run
# returns. Passed through verbatim, so it must match a mode the Actor accepts.
APIFY_PROFILE_SCRAPER_MODE=Profile details no email ($4 per 1k)
# Max wait for an Actor run to finish before giving up with SOURCE_UNAVAILABLE.
APIFY_TIMEOUT_MS=30000

# --- LinkedIn OIDC ---
# Required ONLY when PROFILE_SOURCE=linkedin-oidc. Secrets: keep out of git.
# This is Sign In with LinkedIn (OIDC) and is authorized for the authenticated
# user's OWN profile only. It is not a lookup API for arbitrary profiles.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
APIFY_API_TOKEN=your apify token
APIFY_ACTOR_ID=dev_fusion/Linkedin-Profile-Scraper
PROFILE_SOURCE=apify
APIFY_TIMEOUT_MS=30000
